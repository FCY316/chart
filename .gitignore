# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 公开环境配置（development/test/production/example）随 Git 提交。
# 本机临时覆盖文件不提交；不要把凭据放进上述公开配置。
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 运行时数据单独备份，不随源码发布。
/data/*.json
/data/*.tmp
/data/*.lock
/data/*.db*
/data/*.sqlite*
